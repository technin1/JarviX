# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key
# A anon key vive no frontend (frontend/public/supabaseClient.js), não aqui —
# ela é pública por natureza, protegida por RLS, não por sigilo.

# Groq (fallback quando o modelo próprio não sabe responder)
GROQ_API_KEY=sua-api-key-groq
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo próprio (ai-core)
USE_LOCAL_MODEL=false        # true só quando tiver GPU disponível
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LORA_ADAPTER_PATH=./finetune/adapters/latest
CONFIDENCE_THRESHOLD=0.55

# Backend
PORT=3000
AI_CORE_URL=http://ai-core:8000
REDIS_URL=redis://redis:6379

# Origens permitidas por CORS, separadas por vírgula. Sem isso, o CORS
# bloqueia tudo por padrão (mais seguro que liberar geral). Ex:
# ALLOWED_ORIGINS=http://129.121.33.93,https://seudominio.com
ALLOWED_ORIGINS=

# E-mail transacional (alertas de vencimento de CNH, etc.)
# Use um provedor tipo Resend, SendGrid ou Mailgun — não é o mesmo SMTP
# do e-mail de autenticação do Supabase, que é configurado no painel deles.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=JarviX <no-reply@seudominio.com>
